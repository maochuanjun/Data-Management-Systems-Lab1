# 环境变量示例（不是自动加载的配置文件）
# 默认运行 make run / make integration 时使用 compose.yaml 的 MongoDB：
#   MONGO_URI=mongodb://127.0.0.1:27018/?directConnection=true
#   MONGO_DB=questionnaire_lab1
#
# 使用其他 MongoDB 时，可以直接覆盖：
#   MONGO_URI='mongodb://127.0.0.1:27017' MONGO_DB=my_survey make run
#
# 也可以把本文件复制为 .env，再在 POSIX shell 中执行：
#   set -a; . ./.env; set +a
#   make run
# make 不会自动读取 .env；上述 shell 命令负责将变量导出。
MONGO_URI='mongodb://127.0.0.1:27018/?directConnection=true'
MONGO_DB=questionnaire_lab1
LISTEN_ADDR=127.0.0.1
PORT=8080
COOKIE_SECURE=false

# 测试可单独指定 MongoDB 连接地址；缺省与 MONGO_URI 相同。
# INTEGRATION_MONGO_URI='mongodb://127.0.0.1:27018/?directConnection=true'
